#spring.application.name=omong
#
## ===== 업로드(키오스크 사진) =====
#spring.servlet.multipart.max-file-size=15MB
#spring.servlet.multipart.max-request-size=15MB
#
## ===== AI 제공자 스위치 =====
## mindlogic | claude | ollama | mock  (모든 모델 실패 시 자동 규칙 폴백 → 데모 안 죽음)
#kiosk.ai.provider=mindlogic
## 단일 모델(참고용). 실제 호출은 아래 kiosk.ai.models 체인을 우선 사용.
#kiosk.ai.model=claude-sonnet-4-6
## 폴백 체인: 하나의 MindLogic 키로 앞에서부터 시도, 실패하면 다음 모델로.
##  순서 = 클로드 → OpenAI → Groq → Gemini. 실제 사용 가능한 id는
##  GET https://factchat-cloud.mindlogic.ai/v1/gateway/models/ 로 확인 후 조정하세요.
##  (지원 안 되는 모델 id는 자동으로 건너뜀)
#kiosk.ai.models=claude-sonnet-4-6,gpt-5.4-mini,llama-3.3-70b-versatile,gemini-3-flash-preview
## 모델 호환성을 위해 temperature 는 기본 미전송(-1). 필요하면 0~2 로 지정.
#mindlogic.temperature=-1
## ===== Claude (Anthropic) — 기본 =====
## 실제 키는 환경변수 ANTHROPIC_API_KEY 로 넣으세요. (아래는 더미 자리값)
#spring.ai.anthropic.api-key=${ANTHROPIC_API_KEY:sk-ant-REPLACE_ME}
## 모델 id 는 사용 중인 계정에 맞게 조정 (예: claude-sonnet-4-5 등)
#spring.ai.anthropic.chat.options.model=claude-sonnet-4-5
#spring.ai.anthropic.chat.options.temperature=0.3
#
## ===== Ollama (로컬) — 폴백/대체 =====
#spring.ai.ollama.base-url=http://localhost:11434
#spring.ai.ollama.chat.options.model=llava
#spring.ai.ollama.chat.options.temperature=0.2
## spring.ai.ollama.init.pull-model-strategy=when_missing
#kiosk.ai.vision-model=llava
#
